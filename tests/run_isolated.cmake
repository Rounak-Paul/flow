# Run a test against fresh scratch data owned exclusively by this build's test suite.
if(NOT DEFINED FLOW_TEST_EXECUTABLE OR NOT DEFINED FLOW_TEST_ROOT OR NOT DEFINED FLOW_TEST_SCRATCH)
    message(FATAL_ERROR "Missing test execution parameters")
endif()
string(FIND "${FLOW_TEST_SCRATCH}" "${FLOW_TEST_ROOT}/" scratch_prefix)
if(NOT scratch_prefix EQUAL 0 OR FLOW_TEST_SCRATCH MATCHES "(^|/)\\.\\.(/|$)")
    message(FATAL_ERROR "Refusing to clean scratch outside the test root")
endif()
file(REMOVE_RECURSE "${FLOW_TEST_SCRATCH}")
file(MAKE_DIRECTORY "${FLOW_TEST_SCRATCH}")
execute_process(COMMAND "${FLOW_TEST_EXECUTABLE}" "${FLOW_TEST_SCRATCH}" RESULT_VARIABLE test_result)
if(NOT test_result EQUAL 0)
    message(FATAL_ERROR "Test failed: ${test_result}")
endif()
